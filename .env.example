# ============================================================================
# OGMA - Configuration Environnement (.env)
# ============================================================================
# INSTRUCTIONS:
# 1. Copier ce fichier: .env.example → .env
# 2. Remplir vos vraies API keys
# 3. JAMAIS commit .env dans Git (déjà dans .gitignore)
# ============================================================================

# === API PROVIDERS (au moins UNE requis pour tests intégration) ===

# OpenAI (Recommandé - rapide et économique avec gpt-4o-mini)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mistral AI (Alternative)
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude (Alternative)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (Alternative)
GOOGLE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GROK (Alternative)
GROK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === AUTRES CONFIGURATIONS (optionnel) ===

# ElevenLabs TTS
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Azure Speech
AZURE_SPEECH_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_SPEECH_REGION=westeurope

# Perchance (génération image)
PERCHANCE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === CONFIGURATION OGMA ===

# Logs debug
DEBUG=false

# Port serveur (default: 8080)
PORT=8080

# ============================================================================
# NOTES:
# - Tests unitaires: Pas d'API key nécessaire (utilisent mocks)
# - Tests intégration: AU MOINS 1 API key requise
# - Coût tests intégration: ~$0.02 par run complet
# - Provider recommandé: OpenAI (gpt-4o-mini) - meilleur rapport qualité/prix
# ============================================================================
